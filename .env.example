# Telegram bot token from @BotFather
BOT_TOKEN=#set your bot token

# Path to the SQLite database file
DB_PATH=data/bot.sqlite3

# Comma-separated Telegram user IDs that are allowed to run admin commands
# (/come, /begin, /done, /engage, /close, /mut, /ban, /unmute, /suspend,
# /safe, /resend, /clean, /setrs, /setrs2) in ANY connected group.
# Don't know your Telegram ID? Message the bot privately with /myid.
# Leave empty to fall back to each group's own Telegram admin/creator status.
ADMIN_IDS=#put your tg id of the admin here

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Reminder intervals (in minutes) - override defaults if needed
LINK_REMINDER_INTERVAL_MIN=15
SCAM_REMINDER_INTERVAL_MIN=20
DELETION_CHECK_INTERVAL_MIN=5

# Mute durations (in days)
FRAUD_MUTE_DAYS=18
SUSPEND_MUTE_DAYS=16
